{
  "name": "p26-back",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "probar-pagos": "node --experimental-test-module-mocks --no-warnings=ExperimentalWarning pruebas/probar-pagos.mjs",
    "probar-backoffice": "node --experimental-test-module-mocks --no-warnings=ExperimentalWarning pruebas/probar-backoffice.mjs",
    "probar": "npm run probar-pagos && npm run probar-backoffice",
    "demo": "node --experimental-test-module-mocks --no-warnings=ExperimentalWarning pruebas/servidor-demo.mjs"
  },
  "description": "Backend GraphQL (Apollo Server) del e-commerce - Practica P2-6",
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "@as-integrations/express5": "^1.1.2",
    "@graphql-tools/schema": "^11.0.4",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "graphql": "^16.9.0",
    "graphql-subscriptions": "^3.0.0",
    "graphql-ws": "^6.4.1",
    "nodemailer": "^10.1.7",
    "pg": "^8.13.1",
    "stripe": "^22.6.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "embedded-postgres": "^18.4.0-beta.17"
  }
