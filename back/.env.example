# Copia este archivo a ".env" y pon la cadena de conexión de tu proyecto Neon.
# La consigues en el dashboard de Neon → Connection string (usa la que incluye "?sslmode=require").
DATABASE_URL=postgresql://usuario:password@ep-xxxx.neon.tech/neondb?sslmode=require

# ---- Pagos con Stripe (https://dashboard.stripe.com → Desarrolladores → Claves de API) ----
# Usa las llaves de PRUEBA: la secreta empieza con sk_test_ y la publicable con pk_test_.
# Con ellas nunca se mueve dinero real. Vacías = el backend arranca sin pagos en línea.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Secreto del webhook (empieza con whsec_). En tu computadora lo imprime `stripe listen`.
STRIPE_WEBHOOK_SECRET=
# Dirección del frontend: Stripe regresa aquí al cliente después de pagar.
WEB_URL=http://localhost:4321

# ---- Correos (opcional) ----
# Sin SMTP_HOST los correos NO salen: quedan como "simulado" y se leen en /admin/correos.
# Con un servidor SMTP (Gmail con contraseña de aplicación, Outlook, Mailtrap, Resend...) se mandan de verdad.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=VinyLink <no-responder@vinylink.mx>
