---
// Archivo compartido (dueño: A). Cambios solo por PR pequeño revisado por A.
// Todas las páginas lo usan: <Layout title="...">contenido</Layout>
import "../styles/global.css";
import "../styles/app.css";
import TopBar from "../components/catalogo/TopBar.astro";
import Footer from "../components/catalogo/Footer.astro";

interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=DM+Serif+Display:ital@0;1&family=Caveat:wght@600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title ? `${title} · VinyLink` : "VinyLink — Tienda de discos"}</title>
  </head>
  <body>
    <div class="app">
      <TopBar />
      <div class="app__body">
        <slot name="sidebar" />
        <main class="app__main">
          <slot />
        </main>
      </div>
      <Footer />
    </div>
  </body>
</html>
