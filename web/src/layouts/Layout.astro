---
// Archivo compartido (dueño: A). Cambios solo por PR pequeño revisado por A.
// Todas las páginas lo usan: <Layout title="..." description="...">contenido</Layout>
//
// PWA: enlaza el manifest y los íconos, y registra el service worker
// (public/sw.js) cuando la página ya terminó de cargar.
// Fuentes: se sirven desde la propia app (fontsource), no desde Google Fonts,
// y las dos que se ven primero se precargan.
import "@fontsource-variable/dm-sans/wght.css";
import "@fontsource/dm-serif-display/latin-400.css";
import "@fontsource/caveat/latin-700.css";
import dmSans from "@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url";
import dmSerif from "@fontsource/dm-serif-display/files/dm-serif-display-latin-400-normal.woff2?url";
import "../styles/global.css";
import "../styles/app.css";
import "../styles/envios.css";
import "../styles/tienda.css";
import TopBar from "../components/catalogo/TopBar.astro";
import Footer from "../components/catalogo/Footer.astro";
import AsistenteChat from "../components/asistente/AsistenteChat.tsx";

interface Props {
  title?: string;
  description?: string;
}

const DESCRIPCION =
  "VinyLink: tienda en línea de discos de vinilo, audífonos e instrumentos musicales. Paga con tarjeta, OXXO, SPEI o PayPal y pregúntale a Vinny, nuestro asistente con IA.";
const { title, description = DESCRIPCION } = Astro.props;
// El asistente es para clientes: no aparece en el panel admin.
const conAsistente = !Astro.url.pathname.startsWith("/admin");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title ? `${title} · VinyLink` : "VinyLink — Tienda de discos"}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#242321" />
    <link rel="preload" href={dmSans} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={dmSerif} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/iconos/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="VinyLink" />
  </head>
  <body>
    <div class="app">
      <TopBar />
      <div class="app__body">
        <slot name="sidebar" />
        <main class="app__main">
          <slot />
        </main>
      </div>
      <Footer />
    </div>
    {conAsistente && <AsistenteChat client:idle />}
    <script>
      if ("serviceWorker" in navigator) {
        addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch(() => {
            // Sin service worker la tienda funciona igual, solo sin modo sin conexión.
          });
        });
      }
    </script>
  </body>
</html>
