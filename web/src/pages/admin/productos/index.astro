---
// Panel admin → Productos (inventario). Lista con precio y stock, filtro por
// categoría y botón para eliminar (POST). Crear y editar viven en
// /admin/productos/[id] ("nuevo" para crear).
import Layout from "../../../layouts/Layout.astro";
import AdminNav from "../../../components/admin/AdminNav.astro";
import { graphqlServer } from "../../../lib/graphql";
import { QUERY_ADMIN_PRODUCTOS, MUTATION_ELIMINAR_PRODUCTO } from "../../../lib/queries/admin.js";
import { dinero } from "../../../lib/formato.js";

const AVISOS: Record<string, string> = {
  creado: "Producto creado.",
  guardado: "Cambios guardados.",
  eliminado: "Producto eliminado.",
};

let error: string | null = null;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  try {
    await graphqlServer(Astro.cookies, MUTATION_ELIMINAR_PRODUCTO, { id: String(form.get("id")) });
    return Astro.redirect("/admin/productos?ok=eliminado", 303);
  } catch (err) {
    error = err instanceof Error ? err.message : String(err);
  }
}

const aviso = AVISOS[Astro.url.searchParams.get("ok") ?? ""] ?? null;
const categoriaId = Astro.url.searchParams.get("categoria") || null;

let productos: any[] = [];
let categorias: any[] = [];
try {
  const datos = await graphqlServer(Astro.cookies, QUERY_ADMIN_PRODUCTOS);
  productos = datos.productos.items;
  categorias = datos.categorias;
} catch (err) {
  error ??= err instanceof Error ? err.message : String(err);
}

const visibles = categoriaId ? productos.filter((p) => p.categoria.id === categoriaId) : productos;
---

<Layout title="Productos · Admin">
  <Fragment slot="sidebar"><AdminNav /></Fragment>

  <section class="admin">
    <div class="admin__cabecera">
      <div>
        <h2>Productos</h2>
        <p class="muted">{visibles.length} {visibles.length === 1 ? "producto" : "productos"}</p>
      </div>
      <a class="btn btn--primario" href="/admin/productos/nuevo">+ Nuevo producto</a>
    </div>

    {aviso && <div class="confirmacion-box"><span>✓ {aviso}</span></div>}
    {
      error && (
        <div class="error-box" role="alert">
          <p>{error}</p>
        </div>
      )
    }

    <nav class="periodos" aria-label="Categoría">
      <a
        href="/admin/productos"
        class:list={["periodos__opcion", { "periodos__opcion--activa": !categoriaId }]}
      >
        Todas
      </a>
      {
        categorias.map((c) => (
          <a
            href={`/admin/productos?categoria=${c.id}`}
            class:list={["periodos__opcion", { "periodos__opcion--activa": c.id === categoriaId }]}
          >
            {c.nombre}
          </a>
        ))
      }
    </nav>

    {
      visibles.length > 0 && (
        <div class="panel-card">
          <div class="tabla-scroll">
            <table class="tabla tabla--productos">
              <thead>
                <tr>
                  <th scope="col">Producto</th>
                  <th scope="col">Categoría</th>
                  <th scope="col" class="num">Precio</th>
                  <th scope="col" class="num">Stock</th>
                  <th scope="col">
                    <span class="sr-only">Acciones</span>
                  </th>
                </tr>
              </thead>
              <tbody>
                {visibles.map((p) => (
                  <tr>
                    <td>
                      <span class="tabla__producto">
                        <img src={p.imagen} alt="" />
                        <a href={`/admin/productos/${p.id}`}>{p.nombre}</a>
                      </span>
                    </td>
                    <td>{p.categoria.nombre}</td>
                    <td class="num">{dinero(p.precio)}</td>
                    <td class="num">
                      <span class:list={["stock", { "stock--bajo": p.stock > 0 && p.stock <= 5, "stock--agotado": p.stock === 0 }]}>
                        {p.stock === 0 ? "Agotado" : p.stock}
                      </span>
                    </td>
                    <td class="tabla__acciones">
                      <a class="btn btn--chico" href={`/admin/productos/${p.id}`}>
                        Editar
                      </a>
                      <form
                        method="post"
                        action="/admin/productos"
                        onsubmit="return confirm('¿Eliminar este producto? No se puede deshacer.')"
                      >
                        <input type="hidden" name="id" value={p.id} />
                        <button class="btn btn--chico btn--peligro" type="submit">
                          Eliminar
                        </button>
                      </form>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )
    }
  </section>
</Layout>
