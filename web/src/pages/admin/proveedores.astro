---
// Panel admin → Proveedores. Alta, edición y baja lógica (inactivo). Cada
// proveedor muestra cuántas entradas y piezas ha surtido (desde el kárdex).
// ?editar=3 abre el formulario con sus datos.
import Layout from "../../layouts/Layout.astro";
import AdminNav from "../../components/admin/AdminNav.astro";
import { graphqlServer } from "../../lib/graphql";
import {
  QUERY_PROVEEDORES,
  MUTATION_CREAR_PROVEEDOR,
  MUTATION_ACTUALIZAR_PROVEEDOR,
} from "../../lib/queries/admin.js";
import { fecha } from "../../lib/formato.js";

const AVISOS: Record<string, string> = { creado: "Proveedor creado.", guardado: "Cambios guardados." };

let error: string | null = null;
const editarId = Astro.url.searchParams.get("editar");
let borrador: any = null;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const id = String(form.get("id") ?? "");
  const data = {
    nombre: String(form.get("nombre") ?? ""),
    contacto: String(form.get("contacto") ?? ""),
    email: String(form.get("email") ?? ""),
    telefono: String(form.get("telefono") ?? ""),
    notas: String(form.get("notas") ?? ""),
    activo: form.get("activo") === "on",
  };
  borrador = { ...data, id };
  try {
    if (id) {
      await graphqlServer(Astro.cookies, MUTATION_ACTUALIZAR_PROVEEDOR, { id, data });
      return Astro.redirect("/admin/proveedores?ok=guardado", 303);
    }
    await graphqlServer(Astro.cookies, MUTATION_CREAR_PROVEEDOR, { data });
    return Astro.redirect("/admin/proveedores?ok=creado", 303);
  } catch (err) {
    error = err instanceof Error ? err.message : String(err);
  }
}

let proveedores: any[] = [];
try {
  ({ proveedores } = await graphqlServer(Astro.cookies, QUERY_PROVEEDORES));
} catch (err) {
  error ??= err instanceof Error ? err.message : String(err);
}
const aviso = AVISOS[Astro.url.searchParams.get("ok") ?? ""] ?? null;
const form = borrador ?? proveedores.find((p) => p.id === editarId) ?? { activo: true };
---

<Layout title="Proveedores · Admin">
  <Fragment slot="sidebar"><AdminNav /></Fragment>

  <section class="admin">
    <div class="admin__cabecera">
      <div>
        <h2>Proveedores</h2>
        <p class="muted">Quién te surte la mercancía. Las entradas se registran en Inventario.</p>
      </div>
    </div>

    {aviso && <div class="confirmacion-box"><span>✓ {aviso}</span></div>}
    {
      error && (
        <div class="error-box" role="alert">
          <p>{error}</p>
        </div>
      )
    }

    <div class="admin__fila admin__fila--asimetrica">
      <div class="panel-card">
        <div class="tabla-scroll">
          <table class="tabla">
            <thead>
              <tr>
                <th scope="col">Proveedor</th>
                <th scope="col">Contacto</th>
                <th scope="col" class="num">Entradas</th>
                <th scope="col" class="num">Piezas</th>
                <th scope="col">Última</th>
                <th scope="col"><span class="sr-only">Acciones</span></th>
              </tr>
            </thead>
            <tbody>
              {
                proveedores.length === 0 ? (
                  <tr>
                    <td colspan="6" class="muted">Todavía no hay proveedores.</td>
                  </tr>
                ) : (
                  proveedores.map((p) => (
                    <tr class:list={{ "fila--inactiva": !p.activo }}>
                      <td>
                        {p.nombre}
                        {!p.activo && <span class="etiqueta etiqueta--apagada">Inactivo</span>}
                        {p.notas && <span class="muted tabla__sub">{p.notas}</span>}
                      </td>
                      <td>
                        {p.contacto ?? "—"}
                        <span class="muted tabla__sub">{[p.email, p.telefono].filter(Boolean).join(" · ")}</span>
                      </td>
                      <td class="num">{p.entradas}</td>
                      <td class="num">{p.piezas}</td>
                      <td class="fecha">{fecha(p.ultimaEntrada)}</td>
                      <td>
                        <a class="btn btn--chico" href={`/admin/proveedores?editar=${p.id}`}>
                          Editar
                        </a>
                      </td>
                    </tr>
                  ))
                )
              }
            </tbody>
          </table>
        </div>
      </div>

      <div class="panel-card">
        <h3>{form.id ? "Editar proveedor" : "Nuevo proveedor"}</h3>
        <form method="post" action="/admin/proveedores" class="checkout-form formulario-admin">
          {form.id && <input type="hidden" name="id" value={form.id} />}
          <label>
            Nombre
            <input type="text" name="nombre" required minlength="2" maxlength="100" value={form.nombre ?? ""} />
          </label>
          <label>
            Persona de contacto
            <input type="text" name="contacto" maxlength="100" value={form.contacto ?? ""} />
          </label>
          <div class="formulario-admin__par">
            <label>
              Email
              <input type="email" name="email" maxlength="120" value={form.email ?? ""} />
            </label>
            <label>
              Teléfono
              <input type="tel" name="telefono" maxlength="30" value={form.telefono ?? ""} />
            </label>
          </div>
          <label>
            Notas
            <textarea name="notas" rows="2" maxlength="500">{form.notas ?? ""}</textarea>
          </label>
          <label class="casilla">
            <input type="checkbox" name="activo" checked={form.activo} /> Activo
          </label>
          <button class="btn btn--primario" type="submit">{form.id ? "Guardar cambios" : "Crear proveedor"}</button>
          {form.id && <a class="btn btn--link" href="/admin/proveedores">Cancelar</a>}
        </form>
      </div>
    </div>
  </section>
</Layout>
