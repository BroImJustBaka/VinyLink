---
// Panel admin → Inventario. Resumen (piezas, valor, agotados), formularios
// de entrada de mercancía y de ajuste, y el kárdex: cada cambio de stock con
// su tipo, cantidad, stock resultante, autor y motivo. ?producto=5 filtra el
// kárdex por producto y lo deja elegido en los formularios.
import Layout from "../../layouts/Layout.astro";
import AdminNav from "../../components/admin/AdminNav.astro";
import { graphqlServer } from "../../lib/graphql";
import {
  QUERY_INVENTARIO,
  MUTATION_REGISTRAR_ENTRADA,
  MUTATION_AJUSTAR_STOCK,
} from "../../lib/queries/admin.js";
import { dinero, fechaHora, TIPOS_MOVIMIENTO } from "../../lib/formato.js";
import { puede } from "../../lib/permisos.js";

const POR_PAGINA = 30;
const params = Astro.url.searchParams;
const productoId = params.get("producto") || null;
const tipo = params.get("tipo") || null;
const pagina = Math.max(1, Number.parseInt(params.get("pagina") ?? "1", 10) || 1);

const AVISOS: Record<string, string> = {
  entrada: "Entrada registrada; el stock ya se actualizó.",
  ajuste: "Ajuste registrado.",
};

let error: string | null = null;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const accion = String(form.get("accion"));
  const entero = (c: string) => Number.parseInt(String(form.get(c) ?? ""), 10);
  const producto = String(form.get("productoId") ?? "");
  try {
    if (!producto) throw new Error("Elige un producto");
    if (accion === "entrada") {
      const costo = String(form.get("costoUnitario") ?? "").trim();
      await graphqlServer(Astro.cookies, MUTATION_REGISTRAR_ENTRADA, {
        productoId: producto,
        cantidad: entero("cantidad"),
        proveedorId: String(form.get("proveedorId") ?? "") || null,
        costoUnitario: costo ? Number(costo) : null,
        motivo: String(form.get("motivo") ?? "").trim() || null,
      });
    } else {
      await graphqlServer(Astro.cookies, MUTATION_AJUSTAR_STOCK, {
        productoId: producto,
        stockNuevo: entero("stockNuevo"),
        motivo: String(form.get("motivo") ?? ""),
      });
    }
    return Astro.redirect(`/admin/inventario?producto=${producto}&ok=${accion}`, 303);
  } catch (err) {
    error = err instanceof Error ? err.message : String(err);
  }
}

let datos: any = null;
try {
  datos = await graphqlServer(Astro.cookies, QUERY_INVENTARIO, {
    productoId,
    tipo,
    limite: POR_PAGINA,
    offset: (pagina - 1) * POR_PAGINA,
  });
} catch (err) {
  error ??= err instanceof Error ? err.message : String(err);
}

const aviso = AVISOS[params.get("ok") ?? ""] ?? null;
const resumen = datos?.adminResumenInventario;
const movimientos = datos?.adminMovimientos ?? { items: [], total: 0 };
const productos: any[] = datos?.productos.items ?? [];
const proveedores: any[] = datos?.proveedores ?? [];
const elegido = productos.find((p) => p.id === productoId);
const paginas = Math.max(1, Math.ceil(movimientos.total / POR_PAGINA));
const enlacePagina = (n: number) => {
  const p = new URLSearchParams(params);
  p.delete("ok");
  p.set("pagina", String(n));
  return `/admin/inventario?${p}`;
};
const exportar = puede(Astro.locals.user, "inventario");
---

<Layout title="Inventario · Admin">
  <Fragment slot="sidebar"><AdminNav /></Fragment>

  <section class="admin">
    <div class="admin__cabecera">
      <div>
        <h2>Inventario</h2>
        <p class="muted">Cada cambio de stock queda registrado en el kárdex.</p>
      </div>
      {exportar && <a class="btn" href="/admin/exportar/movimientos.csv" download>⬇ Kárdex CSV</a>}
    </div>

    {aviso && <div class="confirmacion-box"><span>✓ {aviso}</span></div>}
    {
      error && (
        <div class="error-box" role="alert">
          <p>{error}</p>
        </div>
      )
    }

    {
      resumen && (
        <div class="kpis">
          <div class="kpi">
            <span class="kpi__etiqueta">Productos a la venta</span>
            <strong class="kpi__valor">{resumen.productos}</strong>
          </div>
          <div class="kpi">
            <span class="kpi__etiqueta">Piezas en almacén</span>
            <strong class="kpi__valor">{resumen.piezas.toLocaleString("es-MX")}</strong>
          </div>
          <div class="kpi">
            <span class="kpi__etiqueta">Valor a precio de venta</span>
            <strong class="kpi__valor">{dinero(resumen.valorVenta)}</strong>
          </div>
          <div class="kpi">
            <span class="kpi__etiqueta">En su mínimo o debajo</span>
            <strong class="kpi__valor">{resumen.bajoMinimo}</strong>
            <span class="kpi__nota">{resumen.agotados} agotados</span>
          </div>
        </div>
      )
    }

    <div class="admin__fila">
      <div class="panel-card">
        <h3>Entrada de mercancía</h3>
        <form method="post" class="checkout-form formulario-admin">
          <input type="hidden" name="accion" value="entrada" />
          <label>
            Producto
            <select name="productoId" required>
              <option value="">Elige un producto</option>
              {productos.map((p) => (
                <option value={p.id} selected={p.id === productoId}>
                  {p.nombre} {p.sku ? `(${p.sku})` : ""} · {p.stock} pzas
                </option>
              ))}
            </select>
          </label>
          <div class="formulario-admin__par">
            <label>
              Piezas que llegaron
              <input type="number" name="cantidad" required min="1" step="1" />
            </label>
            <label>
              Costo unitario (opcional)
              <input type="number" name="costoUnitario" min="0" step="0.01" />
            </label>
          </div>
          <label>
            Proveedor
            <select name="proveedorId">
              <option value="">Sin proveedor</option>
              {proveedores.map((p) => (
                <option value={p.id}>{p.nombre}</option>
              ))}
            </select>
          </label>
          <label>
            Nota (opcional)
            <input type="text" name="motivo" maxlength="200" placeholder="Factura A-123" />
          </label>
          <button class="btn btn--primario" type="submit">Registrar entrada</button>
        </form>
      </div>

      <div class="panel-card">
        <h3>Ajuste de stock</h3>
        <form method="post" class="checkout-form formulario-admin">
          <input type="hidden" name="accion" value="ajuste" />
          <label>
            Producto
            <select name="productoId" required>
              <option value="">Elige un producto</option>
              {productos.map((p) => (
                <option value={p.id} selected={p.id === productoId}>
                  {p.nombre} · {p.stock} pzas
                </option>
              ))}
            </select>
          </label>
          <label>
            Stock real (piezas contadas)
            <input type="number" name="stockNuevo" required min="0" step="1" value={elegido?.stock} />
          </label>
          <label>
            Motivo (obligatorio)
            <input type="text" name="motivo" required minlength="3" maxlength="200" placeholder="Conteo físico, pieza dañada, merma…" />
          </label>
          <button class="btn" type="submit">Guardar ajuste</button>
        </form>
        <p class="muted">Usa ajustes solo para corregir: las ventas, cancelaciones y reembolsos se registran solos.</p>
      </div>
    </div>

    <div class="panel-card">
      <div class="panel-card__cabecera">
        <h3>Kárdex {elegido && `· ${elegido.nombre}`}</h3>
        <span class="muted">{movimientos.total} movimientos</span>
      </div>
      <form class="filtros" method="get" action="/admin/inventario">
        <label>
          Producto
          <select name="producto">
            <option value="">Todos</option>
            {productos.map((p) => (
              <option value={p.id} selected={p.id === productoId}>
                {p.nombre}
              </option>
            ))}
          </select>
        </label>
        <label>
          Tipo
          <select name="tipo">
            <option value="">Todos</option>
            {Object.entries(TIPOS_MOVIMIENTO).map(([valor, nombre]) => (
              <option value={valor} selected={valor === tipo}>
                {nombre}
              </option>
            ))}
          </select>
        </label>
        <button class="btn btn--primario" type="submit">Filtrar</button>
        {(productoId || tipo) && <a class="btn btn--link" href="/admin/inventario">Quitar filtros</a>}
      </form>
      {
        movimientos.items.length === 0 ? (
          <p class="muted">No hay movimientos con estos filtros.</p>
        ) : (
          <div class="tabla-scroll">
            <table class="tabla">
              <thead>
                <tr>
                  <th scope="col">Fecha</th>
                  <th scope="col">Producto</th>
                  <th scope="col">Tipo</th>
                  <th scope="col" class="num">Cantidad</th>
                  <th scope="col" class="num">Queda</th>
                  <th scope="col">Detalle</th>
                </tr>
              </thead>
              <tbody>
                {movimientos.items.map((m: any) => (
                  <tr>
                    <td class="fecha">{fechaHora(m.creadoEn)}</td>
                    <td>
                      <a href={`/admin/inventario?producto=${m.producto.id}`}>{m.producto.nombre}</a>
                    </td>
                    <td>{TIPOS_MOVIMIENTO[m.tipo as keyof typeof TIPOS_MOVIMIENTO] ?? m.tipo}</td>
                    <td class="num">
                      <span class={`mov mov--${m.cantidad >= 0 ? "entra" : "sale"}`}>
                        {m.cantidad > 0 ? `+${m.cantidad}` : m.cantidad}
                      </span>
                    </td>
                    <td class="num">{m.stockResultante}</td>
                    <td>
                      {m.motivo ?? "—"}
                      <span class="muted tabla__sub">
                        {m.usuario?.nombre ?? "Sistema"}
                        {m.pedidoId && (
                          <>
                            {" · "}
                            <a href={`/admin/pedidos/${m.pedidoId}`}>pedido #{m.pedidoId}</a>
                          </>
                        )}
                        {m.proveedor && ` · ${m.proveedor.nombre}`}
                        {m.costoUnitario != null && ` · ${dinero(m.costoUnitario)} c/u`}
                      </span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }
    </div>

    {
      paginas > 1 && (
        <nav class="paginacion" aria-label="Páginas">
          {pagina > 1 ? <a class="btn" href={enlacePagina(pagina - 1)}>← Anterior</a> : <span />}
          <span class="muted">
            Página {pagina} de {paginas}
          </span>
          {pagina < paginas ? <a class="btn" href={enlacePagina(pagina + 1)}>Siguiente →</a> : <span />}
        </nav>
      )
    }
  </section>
</Layout>
