---
// Dueño: Persona C. Link del correo de recuperación: /restablecer?token=...
// El token viaja en un campo oculto del formulario (no se guarda en ningún
// lado del navegador). Al cambiarla se cierran las demás sesiones y se pide
// iniciar sesión con la contraseña nueva.
import Layout from "../layouts/Layout.astro";
import { graphqlServer } from "../lib/graphql";
import { MUTATION_RESTABLECER_PASSWORD } from "../lib/queries/auth.js";

let token = Astro.url.searchParams.get("token") ?? "";
let listo = false;
let error: string | null = null;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  token = String(form.get("token") ?? "");
  const password = String(form.get("password") ?? "");
  try {
    if (password !== form.get("confirmar")) throw new Error("Las contraseñas no coinciden");
    await graphqlServer(Astro.cookies, MUTATION_RESTABLECER_PASSWORD, { token, password });
    listo = true;
  } catch (err) {
    error = err instanceof Error ? err.message : String(err);
  }
}
---

<Layout title="Nueva contraseña">
  <section class="auth-form">
    <h2>Elige una contraseña nueva</h2>
    {
      listo ? (
        <>
          <div class="confirmacion-box">
            <span>✓ Tu contraseña cambió. Por seguridad cerramos tus sesiones abiertas.</span>
          </div>
          <a class="btn btn--primario" href="/login">
            Iniciar sesión
          </a>
        </>
      ) : !token ? (
        <div class="error-box">
          <p>
            El link está incompleto. <a href="/olvide">Pide uno nuevo</a>.
          </p>
        </div>
      ) : (
        <form method="POST" class="checkout-form">
          <input type="hidden" name="token" value={token} />
          <label>
            Contraseña nueva
            <input type="password" name="password" required minlength="6" maxlength="72" autocomplete="new-password" />
          </label>
          <label>
            Repite la contraseña
            <input type="password" name="confirmar" required minlength="6" maxlength="72" autocomplete="new-password" />
          </label>
          {error && (
            <div class="error-box">
              <p>
                {error} {error.includes("venció") && <a href="/olvide">Pedir otro link</a>}
              </p>
            </div>
          )}
          <button class="btn btn--primario" type="submit">Guardar contraseña</button>
        </form>
      )
    }
  </section>
</Layout>
