---
// Dueño: Persona A. Migrado de front/src/views/CategoryView.jsx.
// Lista de productos de la categoría (numeración A1/B1), filtro ?q= del
// TopBar y 404 si la categoría no existe. El filtro lo hace el backend
// (query buscar con categoriaId), igual que la búsqueda de toda la tienda:
// sin acentos ni mayúsculas, con palabras a medias y tolerancia a errores. El detalle se abre en la isla
// ProductModal, que agrega al carrito con useCartStore (B).
import Layout from "../../layouts/Layout.astro";
import Sidebar from "../../components/catalogo/Sidebar.astro";
import ProductGrid from "../../components/catalogo/ProductGrid.astro";
import ProductModal from "../../components/catalogo/ProductModal.jsx";
import ErrorBox from "../../components/catalogo/ErrorBox.astro";
import { graphqlServer } from "../../lib/graphql";
import { QUERY_CATEGORIA, QUERY_BUSCAR } from "../../lib/queries/catalogo.js";

type Producto = {
  id: string;
  nombre: string;
  descripcion: string;
  precio: number;
  stock: number;
  imagen: string;
};
type Categoria = { id: string; nombre: string; descripcion: string; productos: Producto[] };

const { id } = Astro.params;
const q = (Astro.url.searchParams.get("q") ?? "").trim();

let categoria: Categoria | null = null;
let productos: Producto[] = [];
let aproximada = false;
let error: string | null = null;
try {
  ({ categoria } = await graphqlServer(Astro.cookies, QUERY_CATEGORIA, { id }));
  productos = categoria?.productos ?? [];
  if (categoria && q) {
    ({
      buscar: { productos, aproximada },
    } = await graphqlServer(Astro.cookies, QUERY_BUSCAR, { texto: q, categoriaId: categoria.id }));
  }
} catch (err) {
  error = (err as Error).message;
  Astro.response.status = 502;
}

if (!error && !categoria) return Astro.rewrite("/404");
---

<Layout title={categoria?.nombre ?? "Categoría"}>
  <Fragment slot="sidebar"><Sidebar /></Fragment>

  <section>
    <a class="btn btn--link" href="/">← Volver a categorías</a>

    {error && <ErrorBox mensaje={`No se pudo cargar la categoría: ${error}`} />}

    {
      categoria && (
        <>
          <h2>{categoria.nombre}</h2>
          <p class="muted">{categoria.descripcion}</p>

          {q && (
            <p class="filtro-activo">
              Resultados para <strong>“{q}”</strong> en {categoria.nombre} ·{" "}
              <a class="btn btn--link" href={`/categoria/${categoria.id}`}>Quitar filtro</a> ·{" "}
              <a class="btn btn--link" href={`/buscar?q=${encodeURIComponent(q)}`}>
                Buscar en toda la tienda
              </a>
            </p>
          )}
          {q && aproximada && (
            <p class="aviso-info">No encontramos exactamente “{q}”. Estos son los más parecidos.</p>
          )}

          {productos.length === 0 ? (
            <p class="muted vacio">
              {q
                ? "No hay productos que coincidan con la búsqueda."
                : "Esta categoría todavía no tiene productos."}
            </p>
          ) : (
            <ProductGrid productos={productos} />
          )}
        </>
      )
    }
  </section>

  <ProductModal client:load />
</Layout>
