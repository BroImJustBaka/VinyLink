---
// Dueño: Persona B. Página de un pedido: estado del pago (ficha OXXO, CLABE,
// link o tarjeta), sus productos y el total.
// Renderizada en el servidor: usa la sesión para pedir solo pedidos propios.
import Layout from "../../layouts/Layout.astro";
import PanelPago from "../../components/pagos/PanelPago.astro";
import SeguimientoPago from "../../components/pagos/SeguimientoPago.jsx";
import { graphqlServer } from "../../lib/graphql";
import { ERROR_SIN_SESION, QUERY_PEDIDO } from "../../lib/queries/pedidos.js";
import { dinero, fechaHora, ESTADOS_PEDIDO, METODOS_PAGO } from "../../lib/formato.js";

const { id } = Astro.params;

let pedido = null;
let error: string | null = null;
try {
  ({ pedido } = await graphqlServer(Astro.cookies, QUERY_PEDIDO, { id }));
} catch (err) {
  const mensaje = err instanceof Error ? err.message : String(err);
  if (mensaje.includes(ERROR_SIN_SESION)) {
    return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`);
  }
  error = mensaje;
}

// null = no existe o es de otra persona (se ve igual a propósito).
if (!error && !pedido) return Astro.rewrite("/404");

const pendiente = pedido?.estado === "pendiente";
// Stripe no permite cancelar una ficha OXXO ya generada (vence sola).
const puedeCancelar = pendiente && !(pedido.pago?.oxxo && pedido.pago.estado === "requiere_accion");
---

<Layout title={`Pedido #${id}`}>
  {
    error ? (
      <div class="error-box">
        <p>No se pudo cargar el pedido: {error}</p>
      </div>
    ) : (
      <section class="pedido-view">
        <a class="btn btn--link" href="/perfil">← Mis pedidos</a>

        <div class="pedido-view__cabecera">
          <h2>Pedido #{pedido.id}</h2>
          <span class={`estado estado--${pedido.estado}`}>
            {ESTADOS_PEDIDO[pedido.estado as keyof typeof ESTADOS_PEDIDO] ?? pedido.estado}
          </span>
        </div>
        <p class="muted">
          Realizado el {fechaHora(pedido.fecha)}
          {pedido.metodoPago &&
            ` · ${METODOS_PAGO[pedido.metodoPago as keyof typeof METODOS_PAGO] ?? pedido.metodoPago}`}
        </p>

        <PanelPago pedido={pedido} />
        <SeguimientoPago
          client:load
          pedidoId={pedido.id}
          estado={pedido.estado}
          puedeCancelar={puedeCancelar}
        />

        <ul class="cart-list">
          {pedido.detalles.map((d: any) => (
            <li class="cart-item">
              <img src={d.producto.imagen} alt={d.producto.nombre} />
              <div class="cart-item__info">
                <strong>{d.producto.nombre}</strong>
                <span class="muted">{dinero(d.precioUnitario)} c/u</span>
              </div>
              <span>× {d.cantidad}</span>
              <span class="precio">{dinero(d.subtotal)}</span>
            </li>
          ))}
        </ul>

        <p class="cart-total">
          <strong>Total: {dinero(pedido.total)}</strong>
        </p>

        <div class="cart-acciones">
          <a class="btn btn--primario" href="/">
            Seguir comprando
          </a>
          <a class="btn" href="/perfil">
            Ver mis pedidos
          </a>
        </div>
      </section>
    )
  }
</Layout>
