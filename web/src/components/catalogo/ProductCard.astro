---
// Dueño: Persona A. Migrado de front/src/components/ProductCard.jsx.
// La tarjeta se renderiza en el servidor. Al hacer click, la isla
// ProductModal (que escucha los clicks en [data-producto]) abre el detalle.
// `numero` es opcional: numeración estilo vinilo (A1, A2... B1, B2...).
// `prioridad`: las primeras tarjetas (visibles al cargar) no usan lazy loading.
import { imagen, srcsetDe } from "../../lib/imagen.ts";

interface Props {
  producto: {
    id: string;
    nombre: string;
    descripcion: string;
    precio: number;
    stock: number;
    imagen: string;
  };
  numero?: string;
  prioridad?: boolean;
}

const { producto, numero, prioridad = false } = Astro.props;
const datos = JSON.stringify({
  id: producto.id,
  nombre: producto.nombre,
  descripcion: producto.descripcion,
  precio: producto.precio,
  stock: producto.stock,
  imagen: producto.imagen,
});
---

<button
  type="button"
  class="card"
  data-producto={datos}
  aria-haspopup="dialog"
  aria-label={`Ver detalle de ${producto.nombre}`}
>
  {numero && <span class="card__numero">{numero}</span>}
  <img
    src={imagen(producto.imagen, 300)}
    srcset={srcsetDe(producto.imagen, [200, 300, 400, 600])}
    sizes="(max-width: 480px) 45vw, 220px"
    alt={producto.nombre}
    width="300"
    height="300"
    loading={prioridad ? "eager" : "lazy"}
    decoding="async"
  />
  <h3>{producto.nombre}</h3>
  <p class="precio">${producto.precio.toFixed(2)}</p>
  <p class="muted">{producto.stock > 0 ? `${producto.stock} disponibles` : "Sin stock"}</p>
</button>
