---
// Dueño: Persona C. Hueco del TopBar: sesión del usuario.
const user = Astro.locals.user;
---

{user?.rol === "ADMIN" && (
  <a class="topbar__perfil topbar__admin" href="/admin">
    Panel admin
  </a>
)}

{
  user ? (
    <a class="topbar__perfil" href="/perfil">
      👤 {user.nombre.split(" ")[0]}
    </a>
  ) : (
    <a class="topbar__perfil" href="/login">
      Iniciar sesión
    </a>
  )
}
