---
// Menú lateral del panel admin. Se usa en <Fragment slot="sidebar">.
// Solo muestra las secciones que permite el rol del usuario (lib/permisos.js).
// La sección activa se calcula con la URL actual. Importa admin.css, así
// los estilos del panel solo se cargan en las páginas que lo usan.
// También monta la isla de avisos en tiempo real (subscription eventosAdmin).
import "../../styles/admin.css";
import "../../styles/backoffice.css";
import AvisosAdmin from "./AvisosAdmin.jsx";
import { seccionesDe, seccionDe, NOMBRES_ROL } from "../../lib/permisos.js";

const user = Astro.locals.user!;
const secciones = seccionesDe(user);
const actual = seccionDe(Astro.url.pathname)?.href;
---

<aside class="sidebar">
  <h3>Administración</h3>
  <p class="muted sidebar__rol">{NOMBRES_ROL[user.rol as keyof typeof NOMBRES_ROL] ?? user.rol}</p>
  <AvisosAdmin client:only="react" />
  <ul>
    {
      secciones.map((s) => (
        <li>
          <a
            href={s.href}
            class:list={["sidebar__item", { "sidebar__item--activo": s.href === actual }]}
            aria-current={s.href === actual ? "page" : undefined}
          >
            {s.nombre}
          </a>
        </li>
      ))
    }
    <li>
      <a href="/" class="sidebar__item">← Volver a la tienda</a>
    </li>
  </ul>
</aside>
