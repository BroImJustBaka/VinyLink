# Copia este archivo a ".env". URL del backend GraphQL (carpeta back/).
GRAPHQL_URL=http://localhost:4000/
# WebSocket de las subscriptions (tiempo real). Lo usa el NAVEGADOR, así que
# debe ser la dirección pública del backend (wss:// en producción).
PUBLIC_GRAPHQL_WS_URL=ws://localhost:4000/graphql

# Microservicio del asistente con IA y reseñas (carpeta agente/). Lo llama el
# servidor de Astro, nunca el navegador. La clave debe ser la misma que en agente/.env.
AGENTE_URL=http://localhost:8000/
AGENTE_CLAVE_INTERNA=
