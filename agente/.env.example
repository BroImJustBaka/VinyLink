# Copia este archivo como agente/.env y llena los valores.

# --- Gemini (Google AI Studio, plan gratuito) --- https://aistudio.google.com/apikey
# Si hay GEMINI_API_KEY se usa Gemini; si no, Claude; si no hay ninguna, modo básico sin IA.
GEMINI_API_KEY=
# GEMINI_MODELO=gemini-flash-latest
# GEMINI_MODELO_RESPALDO=gemini-flash-lite-latest   # si el principal está saturado

# --- Claude (Anthropic, opcional y prepagado) --- https://platform.claude.com/settings/keys
# Sin key (o sin saldo) el chat contesta en modo básico, sin IA y sin costo.
ANTHROPIC_API_KEY=
# MODELO=claude-haiku-5-5
# ESFUERZO=low

# --- MongoDB --- local o MongoDB Atlas (mongodb+srv://usuario:contraseña@cluster/...)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=vinylink

# --- Backend GraphQL de la tienda ---
BACKEND_GRAPHQL_URL=http://localhost:4000/

# --- Seguridad --- la misma clave va en web/.env (AGENTE_CLAVE_INTERNA).
# Genera una con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENTE_CLAVE_INTERNA=
# LIMITE_MENSAJES=20
# VENTANA_LIMITE_SEGUNDOS=300
